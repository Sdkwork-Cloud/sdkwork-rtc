# RTC production server environment template (non-secret defaults).
# Copy to secret manager / ConfigMap and replace placeholder values.

SDKWORK_RTC_ENVIRONMENT=production
SDKWORK_RTC_DEPLOYMENT_PROFILE=cloud
SDKWORK_RTC_SERVICE_LAYOUT=split-services
SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18088

# Unified workspace PostgreSQL profile (ENVIRONMENT_SPEC.md §7.1)
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/rtc/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20

# API server startup hydration (single-tenant bootstrap)
SDKWORK_RTC_HYDRATE_TENANT_ID=100
SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=0

# Reconciliation worker scopes (optional; defaults to DB discovery)
# SDKWORK_RTC_RECONCILE_TENANT_SCOPES=100:0,200:0

SDKWORK_RTC_APP_CONTEXT_REQUIRE_SIGNATURE=true
SDKWORK_RTC_APP_CONTEXT_SIGNATURE_SECRET_FILE=/etc/sdkwork/rtc/app-context-signature.secret
OTEL_SERVICE_NAME=sdkwork-rtc-standalone-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
