[Unit]
Description=SDKWork RTC Standalone Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sdkwork/rtc
EnvironmentFile=/etc/sdkwork/rtc/server.env
ExecStart=/opt/sdkwork/rtc/bin/sdkwork-rtc-standalone-gateway
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
