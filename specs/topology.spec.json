  "components": {
    "applicationApiServer": {
      "crate": "sdkwork-api-rtc-standalone-gateway",
      "binary": "sdkwork-api-rtc-standalone-gateway"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-rtc-standalone-gateway",
            "binary": "sdkwork-api-rtc-standalone-gateway",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "rtc-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-rtc-pc",
            "bindEnv": "SDKWORK_RTC_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "capabilitySubset": [
          "application-http"
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ],
        "browserDeliveries": [
          {
            "id": "rtc-adaptive-web",
            "applicationRoot": "apps/sdkwork-rtc-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "rtc-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-rtc-pc",
                "script": "dev",
                "defaultPort": 4951,
                "portEnv": "SDKWORK_RTC_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-rtc-h5",
                "script": "dev",
                "defaultPort": 4952,
                "portEnv": "SDKWORK_RTC_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
      "cloud.development": {
        "processes": [
