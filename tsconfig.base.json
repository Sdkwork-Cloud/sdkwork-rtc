{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@sdkwork/iam-contracts": [
        "../sdkwork-iam/apps/sdkwork-iam-common/packages/sdkwork-iam-contracts/src/index.ts"
      ],
      "@sdkwork/utils": ["../sdkwork-utils/packages/sdkwork-utils-typescript/dist/index.d.ts"],
      "@sdkwork/rtc-sdk": ["sdks/sdkwork-rtc-sdk/sdkwork-rtc-sdk-typescript/src/index.ts"],
      "sdkwork-rtc-app-sdk-generated-typescript": [
        "sdks/sdkwork-rtc-app-sdk/sdkwork-rtc-app-sdk-typescript/generated/server-openapi/dist/index.d.ts"
      ],
      "sdkwork-rtc-app-sdk-generated-typescript/types": [
        "sdks/sdkwork-rtc-app-sdk/sdkwork-rtc-app-sdk-typescript/generated/server-openapi/dist/types/index.d.ts"
      ],
      "sdkwork-rtc-backend-sdk-generated-typescript": [
        "sdks/sdkwork-rtc-backend-sdk/sdkwork-rtc-backend-sdk-typescript/generated/server-openapi/dist/index.d.ts"
      ],
      "@sdkwork/rtc-sdk-provider-volcengine": [
        "sdks/sdkwork-rtc-sdk/sdkwork-rtc-sdk-typescript/providers/rtc-sdk-provider-volcengine/index.d.ts"
      ]
    },
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/target/**"
  ]
}
