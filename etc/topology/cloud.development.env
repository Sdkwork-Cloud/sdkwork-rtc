# cloud.development
SDKWORK_RTC_DEPLOYMENT_PROFILE=cloud
SDKWORK_RTC_ENVIRONMENT=development
SDKWORK_RTC_PROFILE_ID=cloud.development

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_RTC_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18088
SDKWORK_RTC_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_RTC_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

VITE_SDKWORK_RTC_PC_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_RTC_PC_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_RTC_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_RTC_H5_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_RTC_H5_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18088
VITE_SDKWORK_RTC_H5_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
SDKWORK_RTC_WEB_DEV_INGRESS_BIND=127.0.0.1:4949
SDKWORK_RTC_PC_INTERNAL_DEV_PORT=4951
SDKWORK_RTC_H5_INTERNAL_DEV_PORT=4952


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
