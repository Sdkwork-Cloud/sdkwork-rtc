# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_rtc_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_RTC_DEPLOYMENT_PROFILE=cloud
SDKWORK_RTC_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_RTC_PROFILE_ID=cloud.demo
VITE_SDKWORK_RTC_PC_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_RTC_H5_DEPLOYMENT_PROFILE=cloud

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_RTC_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_RTC_APPLICATION_PUBLIC_HTTP_URL=https://rtc-demo.sdkwork.com
SDKWORK_RTC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_RTC_PC_APPLICATION_PUBLIC_HTTP_URL=https://rtc-demo.sdkwork.com
VITE_SDKWORK_RTC_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_RTC_H5_APPLICATION_PUBLIC_HTTP_URL=https://rtc-demo.sdkwork.com
VITE_SDKWORK_RTC_H5_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Redis isolation: dedicate a logical DB index so hardcoded service prefixes never collide across environments.
SDKWORK_RTC_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_RTC_REDIS_ENABLED=true
