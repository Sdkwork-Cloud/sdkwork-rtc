# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_rtc_demo` and a
# dedicated Redis logical DB index so no shared-redis cache key (rate-limit, session, idempotency)
# ever collides with another shared-redis environment.
SDKWORK_RTC_DEPLOYMENT_PROFILE=standalone
SDKWORK_RTC_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_RTC_PROFILE_ID=standalone.demo
VITE_SDKWORK_RTC_PC_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_RTC_H5_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_RTC_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 18088/4949/4951/4952) so a
# meaningfully distinct origin can be published externally for system demonstrations.
SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18078
SDKWORK_RTC_APPLICATION_PUBLIC_HTTP_URL=http://rtc-demo.sdkwork.com:18078
SDKWORK_RTC_WEB_DEV_INGRESS_BIND=0.0.0.0:18078
SDKWORK_RTC_PC_INTERNAL_DEV_PORT=4951
SDKWORK_RTC_H5_INTERNAL_DEV_PORT=4952
VITE_SDKWORK_RTC_PC_APPLICATION_PUBLIC_HTTP_URL=http://rtc-demo.sdkwork.com:18078
VITE_SDKWORK_RTC_H5_APPLICATION_PUBLIC_HTTP_URL=http://rtc-demo.sdkwork.com:18078

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so hardcoded
# service prefixes remain confined to this environment and can never collide with dev/test/staging/prod.
SDKWORK_RTC_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_RTC_REDIS_ENABLED=true
