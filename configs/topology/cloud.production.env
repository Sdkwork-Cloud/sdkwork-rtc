# cloud.production
SDKWORK_RTC_DEPLOYMENT_PROFILE=cloud
SDKWORK_RTC_ENVIRONMENT=production
SDKWORK_RTC_PROFILE_ID=cloud.production

SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18088
SDKWORK_RTC_APPLICATION_PUBLIC_HTTP_URL=https://rtc.sdkwork.com

SDKWORK_API_CLOUD_GATEWAY_BIND=127.0.0.1:3900
SDKWORK_RTC_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
SDKWORK_RTC_PLATFORM_API_GATEWAY_AUTOSTART=true
SDKWORK_API_CLOUD_GATEWAY_CONFIG=configs/sdkwork-api-cloud-gateway.sdkwork-rtc.production.toml

VITE_SDKWORK_RTC_PC_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_RTC_PC_APPLICATION_PUBLIC_HTTP_URL=https://rtc.sdkwork.com
VITE_SDKWORK_RTC_PC_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_RTC_H5_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_RTC_H5_APPLICATION_PUBLIC_HTTP_URL=https://rtc.sdkwork.com
VITE_SDKWORK_RTC_H5_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

SDKWORK_RTC_APP_CONTEXT_REQUIRE_SIGNATURE=true
