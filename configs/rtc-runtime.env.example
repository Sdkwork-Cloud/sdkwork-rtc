# Safe RTC runtime defaults for local development and tests.
# Topology bind: see configs/topology/*.env and specs/topology.spec.json.
SDKWORK_RTC_APP_CONTEXT_REQUIRE_SIGNATURE=false
SDKWORK_RTC_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:18088
# Optional SQLite/Postgres persistence for provider admin state hydration on startup.
# Persistence is opt-in: set one SDKWORK_RTC_DATABASE_* variable below. When unset, the API server runs without SQL persistence.
# SDKWORK_RTC_DATABASE_URL=sqlite://./.runtime/rtc.sqlite
# SDKWORK_RTC_HYDRATE_TENANT_ID=default
# SDKWORK_RTC_HYDRATE_ORGANIZATION_ID=default

# Agora RTC provider
# SDKWORK_RTC_AGORA_ACCESS_ENDPOINT=wss://rtc.agora.local/session
# SDKWORK_RTC_AGORA_REGION=global
# SDKWORK_RTC_AGORA_APP_ID=
# SDKWORK_RTC_AGORA_APP_CERTIFICATE=
# SDKWORK_RTC_AGORA_CREDENTIAL_TTL_SECONDS=3600

# Aliyun RTC provider
# SDKWORK_RTC_ALIYUN_ACCESS_ENDPOINT=wss://rtc.aliyun.local/session
# SDKWORK_RTC_ALIYUN_REGION=cn-shanghai
# SDKWORK_RTC_ALIYUN_APP_ID=
# SDKWORK_RTC_ALIYUN_APP_KEY=
# SDKWORK_RTC_ALIYUN_CREDENTIAL_TTL_SECONDS=3600

# LiveKit RTC provider
# SDKWORK_RTC_LIVEKIT_ACCESS_ENDPOINT=wss://rtc.livekit.local/session
# SDKWORK_RTC_LIVEKIT_REGION=self-hosted
# SDKWORK_RTC_LIVEKIT_API_ENDPOINT=https://livekit.local
# SDKWORK_RTC_LIVEKIT_API_KEY=
# SDKWORK_RTC_LIVEKIT_API_SECRET=
# SDKWORK_RTC_LIVEKIT_CREDENTIAL_TTL_SECONDS=3600

# Volcengine RTC provider
# SDKWORK_RTC_VOLCENGINE_ACCESS_ENDPOINT=wss://rtc.volcengine.local/session
# SDKWORK_RTC_VOLCENGINE_REGION=cn-beijing
# SDKWORK_RTC_VOLCENGINE_APP_ID=
# SDKWORK_RTC_VOLCENGINE_APP_KEY=
# SDKWORK_RTC_VOLCENGINE_CREDENTIAL_TTL_SECONDS=3600
# SDKWORK_RTC_VOLCENGINE_API_ENDPOINT=https://rtc.volcengineapi.com
# SDKWORK_RTC_VOLCENGINE_API_HOST=rtc.volcengineapi.com
# SDKWORK_RTC_VOLCENGINE_API_VERSION=2023-11-01
# SDKWORK_RTC_VOLCENGINE_ACCESS_KEY_ID=
# SDKWORK_RTC_VOLCENGINE_SECRET_ACCESS_KEY=

# Tencent RTC provider
# SDKWORK_RTC_TENCENT_ACCESS_ENDPOINT=wss://rtc.tencent.local/session
# SDKWORK_RTC_TENCENT_REGION=ap-guangzhou
# SDKWORK_RTC_TENCENT_SDK_APP_ID=
# SDKWORK_RTC_TENCENT_SDK_SECRET_KEY=
# SDKWORK_RTC_TENCENT_CREDENTIAL_TTL_SECONDS=3600
# SDKWORK_RTC_TENCENT_API_ENDPOINT=https://trtc.tencentcloudapi.com
# SDKWORK_RTC_TENCENT_API_HOST=trtc.tencentcloudapi.com
# SDKWORK_RTC_TENCENT_API_VERSION=2019-07-22
# SDKWORK_RTC_TENCENT_SECRET_ID=
# SDKWORK_RTC_TENCENT_SECRET_KEY=
