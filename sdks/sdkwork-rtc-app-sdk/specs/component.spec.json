{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-rtc-app-sdk",
    "displayName": "SDKWork RTC App SDK",
    "version": "0.1.0",
    "type": "sdk-family",
    "root": "sdkwork-rtc/sdks/sdkwork-rtc-app-sdk",
    "domain": "rtc",
    "declaredDomain": "rtc",
    "capability": "app-sdk",
    "status": "standardizing",
    "languages": [
      "typescript",
      "rust",
      "java",
      "python",
      "go"
    ],
    "generated": true,
    "private": true,
    "manifests": [
      ".sdkwork-assembly.json"
    ]
  },
  "contracts": {
    "publicExports": [],
    "runtimeEntrypoints": [
      "bin/generate-sdk.mjs"
    ],
    "sdkClients": [],
    "sdkDependencies": [
      {
        "workspace": "sdkwork-rtc-sdk",
        "role": "provider-runtime-sdk",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": null,
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/rtc-sdk",
          "rust": "sdkwork-rtc-sdk",
          "java": "com.sdkwork:sdkwork-rtc-sdk",
          "python": "sdkwork-rtc-sdk",
          "go": "github.com/sdkwork/sdkwork-rtc-sdk"
        }
      },
      {
        "workspace": "sdkwork-drive-app-sdk",
        "role": "drive-media-resource-app-capability",
        "required": true,
        "dependencyMode": "consumer-sdk",
        "apiPrefix": "/app/v3/api",
        "apiAuthority": "sdkwork-drive.app",
        "generatedTransportImportPolicy": "forbidden",
        "packageByLanguage": {
          "typescript": "@sdkwork/drive-app-sdk",
          "rust": "sdkwork-drive-app-sdk",
          "java": "com.sdkwork:sdkwork-drive-app-sdk",
          "python": "sdkwork-drive-app-sdk",
          "go": "github.com/sdkwork/sdkwork-drive-app-sdk"
        }
      }
    ],
    "events": [],
    "configKeys": [],
    "ownedOperations": [
      "rtc.mediaSessions.list",
      "rtc.mediaSessions.create",
      "rtc.mediaSessions.retrieve",
      "rtc.mediaSessions.completionRecord.retrieve",
      "rtc.mediaSessions.participantCredentials.issue",
      "rtc.mediaSessions.recordingArtifacts.list",
      "rtc.providerProfiles.active.list",
      "rtc.rooms.list",
      "rtc.rooms.retrieve"
    ]
  },
  "verification": {
    "commands": [
      "node tools/rtc_sdk_generate.mjs --check --family sdkwork-rtc-app-sdk"
    ]
  }
}
