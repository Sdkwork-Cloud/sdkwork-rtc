{
  "name": "@sdkwork/rtc-app-sdk",
  "version": "0.1.2",
  "description": "SDKWork composed consumer facade for @sdkwork/rtc-app-sdk.",
  "type": "module",
  "private": false,
  "main": "./generated/server-openapi/dist/index.cjs",
  "module": "./generated/server-openapi/dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./generated/server-openapi/dist/index.js",
      "default": "./generated/server-openapi/dist/index.js"
    }
  },
  "dependencies": {
    "@sdkwork/sdk-common": "^1.0.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "dist",
    "composed",
    "generated/server-openapi/dist",
    "generated/server-openapi/src",
    "generated/server-openapi/sdkwork-sdk.json",
    "generated/server-openapi/README.md",
    "generated/server-openapi/LICENSE",
    "generated/domains/server-openapi/dist",
    "generated/domains/server-openapi/src",
    "generated/domains/server-openapi/sdkwork-sdk.json",
    "generated/domains/server-openapi/README.md",
    "generated/domains/server-openapi/LICENSE",
    "README.md",
    "LICENSE"
  ]
}
