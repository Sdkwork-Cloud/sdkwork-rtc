{
  "schemaVersion": "2026-06-06.sdkwork.workflow.v1",
  "app": {
    "id": "sdkwork-rtc",
    "name": "SDKWork RTC",
    "repository": "Sdkwork-Cloud/sdkwork-rtc",
    "sourcePath": "."
  },
  "release": {
    "artifactPrefix": "sdkwork-rtc",
    "defaultVersion": "0.1.0",
    "changelog": {
      "source": "auto",
      "maxCommitSubjects": 50
    }
  },
  "dependencies": [
    {
      "id": "sdkwork-appbase",
      "repository": "Sdkwork-Cloud/sdkwork-appbase",
      "ref": "main",
      "refInput": "SDKWORK_APPBASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-web-framework",
      "repository": "Sdkwork-Cloud/sdkwork-web-framework",
      "ref": "main",
      "refInput": "SDKWORK_WEB_FRAMEWORK_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-database",
      "repository": "Sdkwork-Cloud/sdkwork-database",
      "ref": "main",
      "refInput": "SDKWORK_DATABASE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-drive",
      "repository": "Sdkwork-Cloud/sdkwork-drive",
      "ref": "main",
      "refInput": "SDKWORK_DRIVE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-sdk-generator",
      "repository": "Sdkwork-Cloud/sdkwork-sdk-generator",
      "ref": "main",
      "refInput": "SDKWORK_SDK_GENERATOR_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    },
    {
      "id": "sdkwork-app-topology",
      "repository": "Sdkwork-Cloud/sdkwork-app-topology",
      "ref": "main",
      "refInput": "SDKWORK_APP_TOPOLOGY_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN"
    }
  ],
  "verificationDependencies": [
    {
      "id": "sdkwork-im",
      "repository": "Sdkwork-Cloud/sdkwork-im",
      "ref": "main",
      "refInput": "SDKWORK_IM_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN",
      "purpose": "RTC-IM migration boundary contract tests"
    },
    {
      "id": "sdkwork-core",
      "repository": "Sdkwork-Cloud/sdkwork-core",
      "ref": "main",
      "refInput": "SDKWORK_CORE_REF",
      "tokenSecret": "SDKWORK_RELEASE_TOKEN",
      "purpose": "RTC core aggregation boundary contract tests"
    }
  ],
  "toolchains": {
    "node": "22",
    "pnpm": "10.33.0",
    "rust": "stable",
    "flutter": "stable"
  },
  "lifecycle": {
    "install": [
      {
        "name": "Install workspace dependencies",
        "shell": "pwsh",
        "run": "pnpm install --no-frozen-lockfile"
      }
    ],
    "build": [
      {
        "name": "Run SDKWork RTC contract checks",
        "shell": "pwsh",
        "run": "pnpm run verify"
      }
    ],
    "package": [
      {
        "name": "Package RTC cloud gateway config bundle",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\nswitch ($env:SDKWORK_PACKAGE_PROFILE) {\n  'cloud-config' { pnpm gateway:cloud:bundle }\n  default { Write-Host \"Skipping RTC package archive for profile $($env:SDKWORK_PACKAGE_PROFILE)\" }\n}"
      }
    ],
    "validate": [
      {
        "name": "Validate RTC cloud gateway config bundle",
        "shell": "pwsh",
        "run": "$ErrorActionPreference = \"Stop\"\nswitch ($env:SDKWORK_PACKAGE_PROFILE) {\n  'cloud-config' { pnpm gateway:cloud:bundle:validate }\n  default { Write-Host \"Skipping RTC package validation for profile $($env:SDKWORK_PACKAGE_PROFILE)\" }\n}"
      }
    ]
  },
  "targets": [
    {
      "id": "linux-x64-server-tar-gz",
      "profile": "server",
      "platform": "linux",
      "architecture": "x64",
      "formats": ["tar.gz"],
      "runner": "ubuntu-24.04",
      "outputGlobs": ["artifacts/release/**/*"]
    },
    {
      "id": "cloud-config-bundle-tar-gz",
      "profile": "cloud-config",
      "platform": "all",
      "architecture": "all",
      "formats": ["tar.gz"],
      "runner": "ubuntu-24.04",
      "outputGlobs": ["dist/cloud-config/sdkwork-rtc-api-gateway-config-*.tar.gz"]
    }
  ],
  "security": {
    "artifactAttestations": true,
    "sbomRequired": true,
    "signingRequired": false
  },
  "publish": {
    "workflowArtifact": true,
    "githubRelease": false,
    "retentionDays": 30
  }
}
